# ==================== SERVER ====================
NODE_ENV=production
PORT=5000

# ==================== DATABASE ====================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/edumatch

# ==================== AUTH ====================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ==================== EMAIL — PRODUCTION (Render) ====================
# Dùng Resend API — không cần mở port SMTP trên Render
# Đăng ký tại: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sau khi verify domain trên Resend, đổi thành email domain của bạn:
RESEND_FROM=EduMatch <noreply@yourdomain.com>

# ==================== EMAIL — LOCAL DEV (SMTP) ====================
# Chỉ dùng khi chạy local, không cần trên Render
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_FROM=your@gmail.com

# ==================== GOOGLE OAUTH ====================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==================== AI (optional) ====================
# GEMINI_API_KEY=your-gemini-api-key
